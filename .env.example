# Supabase public browser config
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase server-only secret (never expose to NEXT_PUBLIC variables)
SUPABASE_SERVICE_ROLE_KEY=

# Brevo SMTP API (server-only)
BREVO_API_KEY=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=Sendvoria

# Brevo webhook shared secret; configure same value in Brevo webhook header
BREVO_WEBHOOK_SECRET=

# Live sending is locked until sender identity/domain are verified in Brevo.
# Set these to true only after completing verification and testing unsubscribe.
SENDER_DOMAIN_VERIFIED=false
SENDVORIA_LIVE_SENDING_ENABLED=false

# Free-plan safety cap; application hard-caps at 300/day
SENDVORIA_DAILY_EMAIL_LIMIT=300
